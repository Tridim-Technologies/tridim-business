# Optional organization invitation email via Django's SMTP backend.
# Supply these variables to the backend process; Django does not load .env files.
# Replace the example values first. Keep delivery disabled until the frontend URL
# and SMTP account are configured for the environment.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL="Tridim Business <no-reply@example.com>"
INVITATION_EMAIL_ENABLED=0
INVITATION_BASE_URL=https://app.example.com
